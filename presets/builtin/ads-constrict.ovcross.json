{
  "format": "overley.crosshair",
  "version": 1,
  "meta": {
    "name": "ADS Constrict",
    "author": "Overley",
    "description": "Кольцо сжимается при зажатой ПКМ (прицеливании) — имитация сведения прицела.",
    "tags": [
      "reactive",
      "ads",
      "ring"
    ],
    "license": "CC0-1.0",
    "source": "builtin"
  },
  "canvas": {
    "size": [
      128,
      128
    ],
    "dpiScale": "auto"
  },
  "style": {
    "opacity": 1,
    "outline": {
      "color": "#000000CC",
      "width": 1.25,
      "enabled": true
    },
    "pixelSnap": true
  },
  "layers": [
    {
      "id": "ring",
      "type": "ring",
      "r": 14,
      "thickness": 1.5,
      "fill": "#00FF66"
    },
    {
      "id": "dot",
      "type": "circle",
      "r": 1.25,
      "fill": "#00FF66"
    }
  ],
  "behavior": {
    "mode": "center",
    "offset": [
      0,
      0
    ],
    "hideWhen": {
      "appNotFocused": true,
      "altTab": true
    },
    "cursorHide": "overlay-only"
  },
  "vars": {
    "ads": "mouseButton2"
  },
  "reactive": {
    "smoothingMs": 60,
    "bindings": [
      {
        "target": "layers.ring.r",
        "value": "14 - 7 * ads",
        "range": [
          4,
          20
        ]
      },
      {
        "target": "layers.ring.opacity",
        "value": "1 - 0.35 * ads",
        "range": [
          0,
          1
        ]
      }
    ]
  }
}
