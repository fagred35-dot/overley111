{
  "format": "overley.crosshair",
  "version": 1,
  "meta": {
    "name": "Classic Green",
    "author": "Overley",
    "description": "Классический крест с зазором и точкой, зелёный как в CS.",
    "tags": [
      "cross",
      "static",
      "cs"
    ],
    "license": "CC0-1.0",
    "source": "builtin"
  },
  "canvas": {
    "size": [
      128,
      128
    ],
    "dpiScale": "auto"
  },
  "style": {
    "opacity": 1,
    "outline": {
      "color": "#000000CC",
      "width": 1.25,
      "enabled": true
    },
    "pixelSnap": true
  },
  "layers": [
    {
      "id": "n",
      "type": "rect",
      "size": [
        2.0,
        8.0
      ],
      "pos": [
        0,
        -12.0
      ],
      "fill": "#00FF66"
    },
    {
      "id": "s",
      "type": "rect",
      "size": [
        2.0,
        8.0
      ],
      "pos": [
        0,
        12.0
      ],
      "fill": "#00FF66"
    },
    {
      "id": "w",
      "type": "rect",
      "size": [
        8.0,
        2.0
      ],
      "pos": [
        -12.0,
        0
      ],
      "fill": "#00FF66"
    },
    {
      "id": "e",
      "type": "rect",
      "size": [
        8.0,
        2.0
      ],
      "pos": [
        12.0,
        0
      ],
      "fill": "#00FF66"
    },
    {
      "id": "dot",
      "type": "circle",
      "r": 1,
      "fill": "#00FF66"
    }
  ],
  "behavior": {
    "mode": "center",
    "offset": [
      0,
      0
    ],
    "hideWhen": {
      "appNotFocused": true,
      "altTab": true
    },
    "cursorHide": "overlay-only"
  }
}
