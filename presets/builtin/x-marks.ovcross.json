{
  "format": "overley.crosshair",
  "version": 1,
  "meta": {
    "name": "X Marks the Spot",
    "author": "Overley",
    "description": "Крест накрест: две повёрнутые полосы и белая точка.",
    "tags": [
      "fun",
      "x",
      "rotated"
    ],
    "license": "CC0-1.0",
    "source": "builtin"
  },
  "canvas": {
    "size": [
      128,
      128
    ],
    "dpiScale": "auto"
  },
  "style": {
    "opacity": 1,
    "outline": {
      "color": "#000000CC",
      "width": 1.25,
      "enabled": true
    },
    "pixelSnap": true
  },
  "layers": [
    {
      "id": "x1",
      "type": "rect",
      "size": [
        22,
        2.5
      ],
      "rotate": 45,
      "fill": "#FF7A00"
    },
    {
      "id": "x2",
      "type": "rect",
      "size": [
        22,
        2.5
      ],
      "rotate": -45,
      "fill": "#FF7A00"
    },
    {
      "id": "dot",
      "type": "circle",
      "r": 1.25,
      "fill": "#FFFFFF"
    }
  ],
  "behavior": {
    "mode": "center",
    "offset": [
      0,
      0
    ],
    "hideWhen": {
      "appNotFocused": true,
      "altTab": true
    },
    "cursorHide": "overlay-only"
  }
}
