{
  "format": "overley.crosshair",
  "version": 1,
  "meta": {
    "name": "Reactive Spread",
    "author": "Overley",
    "description": "Крест расходится от скорости мыши и собирается в покое (только сигналы мыши, не данные игры).",
    "tags": [
      "reactive",
      "cross",
      "animated"
    ],
    "license": "CC0-1.0",
    "source": "builtin"
  },
  "canvas": {
    "size": [
      128,
      128
    ],
    "dpiScale": "auto"
  },
  "style": {
    "opacity": 1,
    "outline": {
      "color": "#000000CC",
      "width": 1.25,
      "enabled": true
    },
    "pixelSnap": true
  },
  "layers": [
    {
      "id": "n",
      "type": "rect",
      "size": [
        2,
        8
      ],
      "pos": [
        0,
        -12
      ],
      "fill": "#FFFFFF"
    },
    {
      "id": "s",
      "type": "rect",
      "size": [
        2,
        8
      ],
      "pos": [
        0,
        12
      ],
      "fill": "#FFFFFF"
    },
    {
      "id": "w",
      "type": "rect",
      "size": [
        8,
        2
      ],
      "pos": [
        -12,
        0
      ],
      "fill": "#FFFFFF"
    },
    {
      "id": "e",
      "type": "rect",
      "size": [
        8,
        2
      ],
      "pos": [
        12,
        0
      ],
      "fill": "#FFFFFF"
    },
    {
      "id": "dot",
      "type": "circle",
      "r": 1.25,
      "fill": "#FF2E63"
    }
  ],
  "behavior": {
    "mode": "center",
    "offset": [
      0,
      0
    ],
    "hideWhen": {
      "appNotFocused": true,
      "altTab": true
    },
    "cursorHide": "overlay-only"
  },
  "vars": {
    "speed": "clamp(mouseSpeed / 3000, 0, 1)"
  },
  "reactive": {
    "smoothingMs": 80,
    "bindings": [
      {
        "target": "layers.n.pos",
        "value": "[0, -12 - 9 * speed]",
        "range": [
          -40,
          40
        ]
      },
      {
        "target": "layers.s.pos",
        "value": "[0, 12 + 9 * speed]",
        "range": [
          -40,
          40
        ]
      },
      {
        "target": "layers.w.pos",
        "value": "[-12 - 9 * speed, 0]",
        "range": [
          -40,
          40
        ]
      },
      {
        "target": "layers.e.pos",
        "value": "[12 + 9 * speed, 0]",
        "range": [
          -40,
          40
        ]
      }
    ]
  }
}
