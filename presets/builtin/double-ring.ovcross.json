{
  "format": "overley.crosshair",
  "version": 1,
  "meta": {
    "name": "Double Ring",
    "author": "Overley",
    "description": "Два кольца: внутреннее для точки, внешнее для разброса.",
    "tags": [
      "ring",
      "double",
      "static"
    ],
    "license": "CC0-1.0",
    "source": "builtin"
  },
  "canvas": {
    "size": [
      128,
      128
    ],
    "dpiScale": "auto"
  },
  "style": {
    "opacity": 1,
    "outline": {
      "color": "#000000CC",
      "width": 1.25,
      "enabled": true
    },
    "pixelSnap": true
  },
  "layers": [
    {
      "id": "r1",
      "type": "ring",
      "r": 7,
      "thickness": 1.25,
      "fill": "#FFFFFF"
    },
    {
      "id": "r2",
      "type": "ring",
      "r": 14,
      "thickness": 1,
      "fill": "#FFFFFF",
      "opacity": 0.55
    },
    {
      "id": "dot",
      "type": "circle",
      "r": 1,
      "fill": "#FFFFFF"
    }
  ],
  "behavior": {
    "mode": "center",
    "offset": [
      0,
      0
    ],
    "hideWhen": {
      "appNotFocused": true,
      "altTab": true
    },
    "cursorHide": "overlay-only"
  }
}
