{
  "format": "overley.crosshair",
  "version": 1,
  "meta": {
    "name": "Dot Fortress",
    "author": "Overley",
    "description": "Точка с очень толстой обводкой — видно даже в дыму.",
    "tags": [
      "dot",
      "outline",
      "static"
    ],
    "license": "CC0-1.0",
    "source": "builtin"
  },
  "canvas": {
    "size": [
      128,
      128
    ],
    "dpiScale": "auto"
  },
  "style": {
    "opacity": 1,
    "outline": {
      "color": "#000000F2",
      "width": 3,
      "enabled": true
    },
    "pixelSnap": true
  },
  "layers": [
    {
      "id": "dot",
      "type": "circle",
      "r": 2.5,
      "fill": "#FF2E63"
    }
  ],
  "behavior": {
    "mode": "center",
    "offset": [
      0,
      0
    ],
    "hideWhen": {
      "appNotFocused": true,
      "altTab": true
    },
    "cursorHide": "overlay-only"
  }
}
