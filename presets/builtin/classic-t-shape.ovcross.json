{
  "format": "overley.crosshair",
  "version": 1,
  "meta": {
    "name": "T-Shape",
    "author": "Overley",
    "description": "Крест без нижней полки: точка прицеливания не перекрыта.",
    "tags": [
      "cross",
      "t",
      "static"
    ],
    "license": "CC0-1.0",
    "source": "builtin"
  },
  "canvas": {
    "size": [
      128,
      128
    ],
    "dpiScale": "auto"
  },
  "style": {
    "opacity": 1,
    "outline": {
      "color": "#000000CC",
      "width": 1.25,
      "enabled": true
    },
    "pixelSnap": true
  },
  "layers": [
    {
      "id": "n",
      "type": "rect",
      "size": [
        2,
        8
      ],
      "pos": [
        0,
        -12
      ],
      "fill": "#00FF66"
    },
    {
      "id": "w",
      "type": "rect",
      "size": [
        8,
        2
      ],
      "pos": [
        -12,
        0
      ],
      "fill": "#00FF66"
    },
    {
      "id": "e",
      "type": "rect",
      "size": [
        8,
        2
      ],
      "pos": [
        12,
        0
      ],
      "fill": "#00FF66"
    },
    {
      "id": "dot",
      "type": "circle",
      "r": 1,
      "fill": "#00FF66"
    }
  ],
  "behavior": {
    "mode": "center",
    "offset": [
      0,
      0
    ],
    "hideWhen": {
      "appNotFocused": true,
      "altTab": true
    },
    "cursorHide": "overlay-only"
  }
}
